<?xml version="1.0" encoding="utf-8"?>
<!--
   A conta do Google Drive (e-mail, data do último backup) não vai no backup do Android nem na
   transferência entre aparelhos: veja ContaDrive.kt.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="financacelular_conta.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="financacelular_conta.xml"/>
    </device-transfer>
</data-extraction-rules>
