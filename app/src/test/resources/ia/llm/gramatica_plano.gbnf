root ::= "{\"chamadas\":[" (chamada ("," chamada){0,3})? "]}"
chamada ::= c-ranking | c-gasto-categoria | c-total-mes | c-comparar-mes-anterior | c-maior-gasto | c-orcamento-restante | c-assinaturas | c-poupanca | c-receitas | c-media-mensal | c-atipicos | c-como-economizar
c-ranking ::= "{\"f\":\"ranking\"" ",\"mes\":" mes "}"
c-gasto-categoria ::= "{\"f\":\"gasto_categoria\"" ",\"mes\":" mes ",\"categoria\":" categoria "}"
c-total-mes ::= "{\"f\":\"total_mes\"" ",\"mes\":" mes "}"
c-comparar-mes-anterior ::= "{\"f\":\"comparar_mes_anterior\"" ",\"mes\":" mes "}"
c-maior-gasto ::= "{\"f\":\"maior_gasto\"" ",\"mes\":" mes (",\"categoria\":" categoria)? "}"
c-orcamento-restante ::= "{\"f\":\"orcamento_restante\"" ",\"mes\":" mes (",\"categoria\":" categoria)? "}"
c-assinaturas ::= "{\"f\":\"assinaturas\"" "}"
c-poupanca ::= "{\"f\":\"poupanca\"" ",\"mes\":" mes "}"
c-receitas ::= "{\"f\":\"receitas\"" ",\"mes\":" mes "}"
c-media-mensal ::= "{\"f\":\"media_mensal\"" (",\"categoria\":" categoria)? "}"
c-atipicos ::= "{\"f\":\"atipicos\"" ",\"mes\":" mes "}"
c-como-economizar ::= "{\"f\":\"como_economizar\"" "}"
mes ::= "\"atual\"" | "\"anterior\"" | "\"2026-11\"" | "\"2026-10\"" | "\"2026-09\"" | "\"2026-08\"" | "\"2026-07\"" | "\"2026-06\"" | "\"2026-05\"" | "\"2026-04\"" | "\"2026-03\"" | "\"2026-02\"" | "\"2026-01\"" | "\"2025-12\"" | "\"2025-11\"" | "\"2025-10\"" | "\"2025-09\"" | "\"2025-08\"" | "\"2025-07\"" | "\"2025-06\"" | "\"2025-05\"" | "\"2025-04\"" | "\"2025-03\"" | "\"2025-02\"" | "\"2025-01\"" | "\"2024-12\""
categoria ::= "\"Alimentação\"" | "\"Lazer\"" | "\"Pet \\\"Rex\\\"\""
